{
  "name": "@aeroduct/types",
  "version": "0.0.1",
  "private": true,
  "description": "Shared TypeScript types and API contracts for AeroDuct",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@aeroduct/config": "workspace:*",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
