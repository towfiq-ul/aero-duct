# Server
PORT=8080
GIN_MODE=debug

# Database
DATABASE_URL=postgres://aeroduct:aeroduct@localhost:5432/aeroduct_dev?sslmode=disable

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# JWT
JWT_SECRET=change-me-in-production

# AWS S3 (for video/media upload)
